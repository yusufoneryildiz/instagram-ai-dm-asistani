    {
      "id": "e4ffc56f-5c56-4fba-8651-f285abdd686f",
      "name": "Get 15 newest rows",
      "type": "n8n-nodes-base.code",
      "position": [
        3072,
        544
      ],
      "parameters": {
        "jsCode": "const inputItems = items;\n\n// Nếu danh sách rỗng, trả về rỗng\nif (inputItems.length === 0) {\n  return [];\n}\n\n// Sắp xếp theo thời gian tạo mới nhất\nconst sortedItems = [...inputItems].sort((a, b) => new Date(b.json.createdAt) - new Date(a.json.createdAt));\n\n// Lấy 15 hàng mới nhất\nconst latestItems = sortedItems.slice(0, 15);\n\n// Sắp xếp lại theo thời gian tăng dần để giữ đúng thứ tự hội thoại\nconst finalSorted = [...latestItems].sort((a, b) => new Date(a.json.createdAt) - new Date(b.json.createdAt));\n\n// Trả về kết quả\nreturn finalSorted;\n"
      },
      "typeVersion": 2,
      "alwaysOutputData": true
    },
